#!/bin/sh
#
# @name T022 Quadcopter
#
# @type Quadrotor
# @class Copter
#
. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=T022}

param set-default SIM_GZ_EN 1

param set-default MAV_TYPE 2

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# Rotor 0 (motorNumber 0, CCW, KM+)
param set-default CA_ROTOR0_PX 0.1371
param set-default CA_ROTOR0_PY 0.1371
param set-default CA_ROTOR0_KM 0.0206

# Rotor 1 (motorNumber 1, CCW, KM+)
param set-default CA_ROTOR1_PX -0.1371
param set-default CA_ROTOR1_PY -0.1371
param set-default CA_ROTOR1_KM 0.0206

# Rotor 2 (motorNumber 2, CW, KM-)
param set-default CA_ROTOR2_PX 0.1371
param set-default CA_ROTOR2_PY -0.1371
param set-default CA_ROTOR2_KM -0.0206

# Rotor 3 (motorNumber 3, CW, KM-)
param set-default CA_ROTOR3_PX -0.1371
param set-default CA_ROTOR3_PY 0.1371
param set-default CA_ROTOR3_KM -0.0206

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 0
param set-default SIM_GZ_EC_MIN2 0
param set-default SIM_GZ_EC_MIN3 0
param set-default SIM_GZ_EC_MIN4 0

param set-default SIM_GZ_EC_MAX1 1900
param set-default SIM_GZ_EC_MAX2 1900
param set-default SIM_GZ_EC_MAX3 1900
param set-default SIM_GZ_EC_MAX4 1900

param set-default NAV_DLL_ACT 2
